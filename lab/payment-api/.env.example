# CeruleanPay Payment API - Environment Configuration
# Copy this to .env and fill in actual values
# NEVER commit .env to source control

# Server
NODE_ENV=development
PORT=3000

# PostgreSQL - local dev uses Docker Compose, production uses VPS
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ceruleanpay
DB_USER=cerulean_app
DB_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DB_SSL=false

# Azure - populated by GitHub Actions from org secrets in production
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=

# Azure Container Registry
ACR_NAME=ceruleanpaycr
ACR_LOGIN_SERVER=ceruleanpaycr.azurecr.io

# Azure Key Vault
KEY_VAULT_NAME=ceruleanpay-kv

# Payment gateway integration key - get from internal wiki
# Format: cp_live_<48 hex chars> for production, cp_test_<48 hex chars> for staging
PAYMENT_API_KEY=cp_test_REPLACE_WITH_KEY_FROM_WIKI

# Admin endpoints (internal use only)
ADMIN_API_KEY=REPLACE_WITH_STRONG_RANDOM_VALUE

# JWT signing secret for webhook signatures
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_VALUE
