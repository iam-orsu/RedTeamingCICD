{
  "name": "ceruleanpay-payment-api",
  "version": "2.1.4",
  "description": "Payment processing API for CeruleanPay - processes UPI and card transactions for merchant partners",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --forceExit --coverage",
    "build": "mkdir -p dist && cp -r src package.json dist/"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageDirectory": "coverage",
    "testMatch": ["**/__tests__/**/*.js", "**/*.test.js"]
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
